# pyenv
#   For a library or package, you might want to ignore these files since the Python version is
#   managed by the developer. For a binary/app where you want to lock the version, you might
#   include these.
# .python-version

# pipenv
#   According to pypa/pipenv#598, it is recommended to include Pipfile.lock in version control.
#   However, in case of collaboration, if you want to ignore it, uncomment the following line.
# Pipfile.lock

# poetry
#   Similar to Pipfile.lock, poetry.lock is generally recommended to be committed
# .poetry.lock

# pdm
#   Similar to Pipfile.lock, pdm.lock is generally recommended to be committed
.pdm-plugins/
.pdm-build/

# PEP 582 binary packages
__pypackages__/

